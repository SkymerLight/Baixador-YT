{
  "manifest_version": 3,
  "name": "YT Baixador",
  "short_name": "YT Baixador",
  "version": "1.1.0",
  "description": "Baixe vídeos e áudios do YouTube direto da página. Criador: Skymer#9220",
  "author": "Skymer#9220",
  "homepage_url": "https://github.com/SkymerLight/Baixador-YT",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "notifications", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT Baixador",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["ui/panel.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
